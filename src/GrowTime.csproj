<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local, machine-specific paths (not committed). Copy Environment.props.example to Environment.props. -->
  <Import Project="..\Environment.props" Condition="Exists('..\Environment.props')" />

  <PropertyGroup>
    <!-- Valheim's Unity Mono runtime ships netstandard 2.1, which the game assemblies reference -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GrowTime</AssemblyName>
    <RootNamespace>GrowTime</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Game assemblies pull in Unity's System.IO.Compression 4.2 vs. netstandard's 4.1.3; unused by this mod -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <!-- thunderstore/manifest.json is the single source of truth for the version -->
    <ManifestPath>$(MSBuildThisFileDirectory)..\thunderstore\manifest.json</ManifestPath>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(ManifestPath))), '"version_number"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>

    <!-- Defaults; override them in Environment.props -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ValheimDir)\BepInEx</BepInExDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <DistDir>$(MSBuildThisFileDirectory)..\dist\</DistDir>
  </PropertyGroup>

  <!-- Game / BepInEx assemblies are referenced from your install, never copied into the repo or the output -->
  <ItemGroup>
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)\assembly_guiutils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Translation Include="Translations\*.txt" />
    <Compile Include="$(IntermediateOutputPath)PluginInfo.g.cs" />
  </ItemGroup>

  <Target Name="CheckGamePaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\assembly_valheim.dll')" Text="Valheim not found at '$(ValheimDir)'. Set ValheimDir in Environment.props (see Environment.props.example)." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')" Text="BepInEx not found at '$(BepInExDir)'. Set BepInExDir in Environment.props (see Environment.props.example)." />
  </Target>

  <!-- Expose the manifest version to code, so [BepInPlugin] always matches the package version -->
  <Target Name="GeneratePluginInfo" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)PluginInfo.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace GrowTime { internal static class PluginInfo { internal const string Version = &quot;$(Version)&quot;%3B } }" />
  </Target>

  <!-- Builds dist/Paskutny-GrowTime-<version>.zip, ready for upload to Thunderstore -->
  <Target Name="PackageThunderstore" AfterTargets="Build">
    <PropertyGroup>
      <StagingDir>$(IntermediateOutputPath)thunderstore\</StagingDir>
    </PropertyGroup>
    <Error Condition="!Exists('..\thunderstore\icon.png')" Text="thunderstore/icon.png (256x256) is missing." />
    <RemoveDir Directories="$(StagingDir)" />
    <Copy SourceFiles="..\thunderstore\manifest.json;..\thunderstore\README.md;..\thunderstore\icon.png;..\CHANGELOG.md" DestinationFolder="$(StagingDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StagingDir)plugins" />
    <Copy SourceFiles="@(Translation)" DestinationFolder="$(StagingDir)plugins\Translations" />
    <MakeDir Directories="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(StagingDir)" DestinationFile="$(DistDir)Paskutny-GrowTime-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Thunderstore package: $(DistDir)Paskutny-GrowTime-$(Version).zip" />
  </Target>

  <!-- Optional: copy the plugin into a BepInEx/mod-manager profile for testing (set DeployDir in Environment.props) -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="@(Translation)" DestinationFolder="$(DeployDir)\Translations" />
    <Message Importance="high" Text="Deployed to $(DeployDir)" />
  </Target>

</Project>
